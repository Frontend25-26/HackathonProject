# ─── DATABASE (Railway MySQL сервис — вставь через Reference Variables) ───────
# В Railway UI: Add Variable → Reference → выбери MySQL сервис
DATABASE_URL=${{MySQL.MYSQL_URL}}
MYSQL_HOST=${{MySQL.MYSQLHOST}}
MYSQL_USER=${{MySQL.MYSQLUSER}}
MYSQL_PASSWORD=${{MySQL.MYSQLPASSWORD}}
MYSQL_DATABASE=${{MySQL.MYSQLDATABASE}}
MYSQL_PORT=${{MySQL.MYSQLPORT}}

# ─── AUTH ──────────────────────────────────────────────────────────────────────
# Генерируй: openssl rand -base64 32
AUTH_SECRET=

# URL твоего задеплоенного приложения (Railway даст после первого деплоя)
# Пример: https://myapp.up.railway.app
NEXTAUTH_URL=https://YOUR_APP.up.railway.app

# GitHub OAuth App (создаётся на github.com/settings/developers)
# Homepage URL: https://YOUR_APP.up.railway.app
# Callback URL: https://YOUR_APP.up.railway.app/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ─── GITHUB APP ────────────────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_INSTALLATION_ID=
GITHUB_ORG=
GITHUB_WEBHOOK_SECRET=

# ─── NODE ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
