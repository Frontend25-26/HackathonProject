# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=hackathon_dev
MYSQL_USER=hackathon
MYSQL_PASSWORD=hackathon
MYSQL_HOST=localhost
MYSQL_PORT=3900

# Prisma
DATABASE_URL="mysql://hackathon:hackathon@localhost:3900/hackathon_dev"

# GitHub Classroom API (нужен токен с правами admin:org или read:org)
GITHUB_TOKEN=

# Auth.js GitHub Provider
# Получи у куратора или создай свой GitHub App на https://github.com/settings/apps
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Сгенерируй сам: openssl rand -base64 32
AUTH_SECRET=

# Для локальной разработки
NEXTAUTH_URL=http://localhost:3000

# GitHub Organization
GITHUB_ORG=Frontend25-26