generator client {
  provider = "prisma-client-js"
  output   = "../src/backend/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                 Int             @id @default(autoincrement())
  githubId           Int             @unique @map("github_id")
  login              String          @unique
  name               String?
  email              String?
  avatar             String?
  role               Role            @default(STUDENT)
  githubToken        String?         @map("github_token") @db.Text
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  createdAssignments Assignment[]    @relation("CreatedBy")
  mentorEnrollments  Enrollment[]    @relation("MentorEnrollments")
  studentEnrollments Enrollment[]    @relation("StudentEnrollments")
  reviewComments     ReviewComment[]
  reviews            Review[]
  submissions        Submission[]
  notifications      Notification[]

  @@map("users")
}

model Course {
  id          Int          @id @default(autoincrement())
  title       String
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  assignments Assignment[]
  enrollments Enrollment[]

  @@map("courses")
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  courseId  Int      @map("course_id")
  studentId Int      @map("student_id")
  mentorId  Int?     @map("mentor_id")
  course    Course   @relation(fields: [courseId], references: [id])
  mentor    User?    @relation("MentorEnrollments", fields: [mentorId], references: [id])
  student   User     @relation("StudentEnrollments", fields: [studentId], references: [id])

  @@unique([courseId, studentId])
  @@index([mentorId], map: "enrollments_mentor_id_fkey")
  @@index([studentId], map: "enrollments_student_id_fkey")
  @@map("enrollments")
}

model Assignment {
  id                    Int          @id @default(autoincrement())
  title                 String
  description           String       @db.Text
  classroomUrl          String       @map("classroom_url")
  classroomAssignmentId Int?         @map("classroom_assignment_id")
  inviteLink            String?      @map("invite_link")
  maxGrade              Int          @map("max_grade")
  dueDate               DateTime     @map("due_date")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  courseId              Int          @map("course_id")
  createdById           Int          @map("created_by_id")
  course                Course       @relation(fields: [courseId], references: [id])
  createdBy             User         @relation("CreatedBy", fields: [createdById], references: [id])
  submissions           Submission[]

  @@index([courseId], map: "assignments_course_id_fkey")
  @@index([createdById], map: "assignments_created_by_id_fkey")
  @@map("assignments")
}

model Submission {
  id           Int              @id @default(autoincrement())
  repoUrl      String           @map("repo_url")
  repoOwner    String?          @map("repo_owner")
  repoName     String?          @map("repo_name")
  prNumber     Int?             @map("pr_number")
  ciStatus     CiStatus         @default(UNKNOWN) @map("ci_status")
  status       SubmissionStatus @default(DRAFT)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  assignmentId Int              @map("assignment_id")
  studentId    Int              @map("student_id")
  review       Review?
  commits      Commit[]
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  student      User             @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([studentId], map: "submissions_student_id_fkey")
  @@map("submissions")
}

model Review {
  id             Int            @id @default(autoincrement())
  grade          Int
  generalComment String?        @map("general_comment") @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  submissionId   Int            @unique @map("submission_id")
  mentorId       Int            @map("mentor_id")
  threads        ReviewThread[]
  mentor         User           @relation(fields: [mentorId], references: [id])
  submission     Submission     @relation(fields: [submissionId], references: [id])

  @@index([mentorId], map: "reviews_mentor_id_fkey")
  @@map("reviews")
}

model ReviewThread {
  id             Int             @id @default(autoincrement())
  filePath       String          @map("file_path")
  line           Int
  githubThreadId Int?            @map("github_thread_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  reviewId       Int             @map("review_id")
  comments       ReviewComment[]
  review         Review          @relation(fields: [reviewId], references: [id])

  @@index([reviewId], map: "review_threads_review_id_fkey")
  @@map("review_threads")
}

model ReviewComment {
  id              Int          @id @default(autoincrement())
  body            String       @db.Text
  githubCommentId Int?         @map("github_comment_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  threadId        Int          @map("thread_id")
  authorId        Int          @map("author_id")
  author          User         @relation(fields: [authorId], references: [id])
  thread          ReviewThread @relation(fields: [threadId], references: [id])

  @@index([authorId], map: "review_comments_author_id_fkey")
  @@index([threadId], map: "review_comments_thread_id_fkey")
  @@map("review_comments")
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum SubmissionStatus {
  DRAFT
  PENDING
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

enum CiStatus {
  UNKNOWN
  PENDING
  RUNNING
  SUCCESS
  FAILURE
}

model Commit {
  id            Int        @id @default(autoincrement())
  sha           String
  message       String     @db.Text
  authorName    String     @map("author_name")
  authorLogin   String?    @map("author_login")
  committedAt   DateTime   @map("committed_at")
  ciStatus      CiStatus   @default(UNKNOWN) @map("ci_status")
  ciDetailsUrl  String?    @map("ci_details_url")
  submissionId  Int        @map("submission_id")
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, sha])
  @@index([submissionId], map: "commits_submission_id_fkey")
  @@map("commits")
}

model SyncLog {
  id                  Int      @id @default(autoincrement())
  entityType          String   @map("entity_type")
  entityId            Int?     @map("entity_id")
  action              String
  success             Boolean
  errorMessage        String?  @map("error_message") @db.Text
  rateLimitRemaining  Int?     @map("rate_limit_remaining")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId], map: "sync_logs_entity_idx")
  @@map("sync_logs")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  body      String?  @db.Text
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "notifications_user_id_idx")
  @@map("notifications")
}
